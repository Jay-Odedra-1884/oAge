# Copy to .env.local and fill in values

# Get from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Your deployed AgeVerifier contract address (after deploying via Remix)
NEXT_PUBLIC_AGE_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000

# AnonAadhaar verifier address for Sepolia testnet
# See: https://github.com/anon-aadhaar/anon-aadhaar/tree/main/packages/contracts
NEXT_PUBLIC_ANON_AADHAAR_ADDRESS=0x...
